FROM alpine:3.24 AS ca-certs

RUN apk --no-cache add ca-certificates

FROM scratch
ARG BINARY
ARG TARGETOS
ARG TARGETARCH

COPY ${TARGETOS}/${TARGETARCH}/${BINARY:-tinkerbell} /tinkerbell
COPY --from=ca-certs /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/
# Apache 2.0 section 4(d) attribution: ship the project LICENSE and the
# generated third-party license bundle for compiled-in Go modules. The
# bundle is generated by goreleaser's before hook (script/third_party_licenses.sh).
COPY LICENSE /usr/share/doc/tinkerbell/LICENSE
COPY out/THIRD_PARTY_LICENSES-${TARGETOS}-${TARGETARCH} /usr/share/doc/tinkerbell/THIRD_PARTY_LICENSES

ENTRYPOINT ["/tinkerbell"]
